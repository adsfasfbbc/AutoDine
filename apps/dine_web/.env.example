# 默认使用内置 Mock，可在没有后端时完整演示。
VITE_USE_MOCK=true

# 仅在 VITE_USE_MOCK=false 时使用。
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# 三端 Agent 默认使用前端 Mock；Agent Hub 提供强制只读建议端点后才可改为 false。
VITE_AGENT_USE_MOCK=true
# 开发环境由 Vite 同源代理到 localhost:8100；生产环境需配置同路径反向代理。
VITE_AGENT_BASE_URL=/agent-api

# 注意：浏览器环境变量会进入前端构建产物。
# 不要在此处填写 OpenAI、通义千问、DeepSeek 等服务的 API Key。
